{
  "hosting": {
    "site": "amplify-leads-2026",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/smsf/**",
        "destination": "/smsf/index.html"
      },
      {
        "source": "/pia/**",
        "destination": "/pia/index.html"
      },
      {
        "source": "/docusignWebhook",
        "function": "docusignWebhook"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
