VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Release metadata and environment labeling
VITE_APP_ENV=development
VITE_RELEASE_VERSION=local
VITE_RELEASE_COMMIT=local
VITE_RELEASE_DEPLOYED_AT=

# Google APIs (use separate keys for security, or reuse one key)
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key
# One-time leads migration/import script
# Use a service account JSON file that has Firebase Admin access and is shared onto the Google Sheet.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
FIREBASE_PROJECT_ID=amplify-leads-2026
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_google_spreadsheet_id/edit
GOOGLE_SHEET_TAB=LEADS
LEADS_IMPORT_DEFAULT_STATUS=DQ
LEADS_IMPORT_DEFAULT_REGION=brisbane
