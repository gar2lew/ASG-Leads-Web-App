rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────
    function canUseOperationalApp() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function hasElevatedRole() {
      return isAuthenticated()
        && request.auth.token.role in ["admin", "director"];
    }

    function isOwner(userId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != "anonymous"
        && request.auth.uid == userId;
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function keepsFieldsImmutable(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validUserDeviceCreate() {
      return hasOnlyFields(["userId", "token", "platform", "createdAt", "updatedAt"])
        && request.resource.data.userId is int
        && request.resource.data.token is string
        && request.resource.data.platform == "web";
    }

    function validUserDeviceUpdate() {
      return keepsFieldsImmutable(["userId", "platform", "createdAt"])
        && request.resource.data.token is string
        && request.resource.data.updatedAt != null;
    }

    // ─────────────────────────────────────────────
    // Core CRM Collections
    // ─────────────────────────────────────────────

    // Reps (users of the system)
    match /reps/{repId} {
      allow read, write: if canUseOperationalApp();
    }

    // Leads (clients) - shared operational data
    match /leads/{leadId} {
      allow read, write: if canUseOperationalApp();

      match /presence/{repId} {
        allow read: if canUseOperationalApp();
        allow create, update: if canUseOperationalApp()
          && hasOnlyFields(["name", "ts"]);
        allow delete: if canUseOperationalApp();
      }

      match /files/{fileId} {
        allow read, write: if canUseOperationalApp();
      }

      match /notes/{noteId} {
        allow read, create: if canUseOperationalApp();
        allow update, delete: if canUseOperationalApp();
      }

      match /dealUpdates/{updateId} {
        allow read, create: if canUseOperationalApp();
        allow update, delete: if false;
      }

      match /{subcollection}/{docId} {
        allow read, write: if canUseOperationalApp();
      }
    }

    // Deals
    match /deals/{dealId} {
      allow read, write: if canUseOperationalApp();
    }

    // Deal documents
    match /dealDocuments/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    // Deal events (immutable log)
    match /dealEvents/{eventId} {
      allow read: if canUseOperationalApp();
      allow create: if canUseOperationalApp()
        && request.resource.data.dealId is string
        && request.resource.data.createdAt != null;
      allow update, delete: if false;
    }

    // Document instances (OA, contracts, etc.)
    match /documentInstances/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    // DocuSign envelopes
    match /docusignEnvelopes/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    // Existing shared operational collections pending role-aware tightening.
    // These are explicit collection rules so they do not rely on a wildcard.
    match /draps/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /commissions/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /invoiceDrafts/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /knockZones/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /customPinTypes/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /clientGroups/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    // ─────────────────────────────────────────────
    // Client Data
    // ─────────────────────────────────────────────

    // Notes
    match /clientNotes/{noteId} {
      allow read: if canUseOperationalApp();
      allow create: if canUseOperationalApp()
        && request.resource.data.clientId is string
        && request.resource.data.content is string;

      allow update: if canUseOperationalApp()
        && keepsFieldsImmutable(["clientId", "createdAt", "createdBy", "createdById"]);
      allow delete: if canUseOperationalApp();
    }

    // Reports
    match /piaReports/{reportId} {
      allow read, write: if canUseOperationalApp();
    }

    match /smsfReports/{reportId} {
      allow read, write: if canUseOperationalApp();
    }

    // SMSF Financial Data (encrypted bank details)
    match /smsfFinancials/{docId} {
      allow read, write: if hasElevatedRole();
    }

    // ─────────────────────────────────────────────
    // App Config / Settings
    // ─────────────────────────────────────────────

    match /appSettings/{docId} {
      // Phase 3: appSettings/config writes are callable-authoritative.
      // Other appSettings docs remain temporarily compatible.
      allow read: if canUseOperationalApp();
      allow write: if canUseOperationalApp()
        && docId != "config";

      match /{sub}/{subId} {
        allow read, write: if canUseOperationalApp();
      }
    }

    match /settings/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /settingsHistory/{docId} {
      // Phase 3: written only by settings admin callables.
      allow read: if isAuthenticated();
      allow create: if false;
      allow update, delete: if false;
    }

    match /calendarServiceTypes/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /appointments/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /knowledgeBase/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /documentLibrary/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /formTemplates/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /scripts/{docId} {
      allow read: if canUseOperationalApp();
      allow write: if hasElevatedRole();
    }

    // Per-user settings. These paths are ready for Firebase UID ownership.
    // Current app code mostly uses numeric rep IDs, so moving more rep-scoped
    // data here requires a UID-to-rep mapping or custom claims first.
    match /users/{userId}/dashboard/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/repSettings/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/dailyHistory/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─────────────────────────────────────────────
    // Activity / Analytics
    // ─────────────────────────────────────────────

    match /analyticsEvents/{docId} {
      allow read: if hasElevatedRole();
      allow create: if canUseOperationalApp()
        && request.resource.data.event is string
        && request.resource.data.repId != null
        && request.resource.data.timestamp != null;
      allow update, delete: if false;
    }

    match /trainingSessions/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /trainingDocuments/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /trainingVideos/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /trainingRecordings/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /trainingCourses/{docId} {
      allow read: if canUseOperationalApp();
      allow write: if hasElevatedRole();
    }

    match /trainingModules/{docId} {
      allow read: if canUseOperationalApp();
      allow write: if hasElevatedRole();
    }

    match /userProgress/{progressId} {
      allow read: if canUseOperationalApp();
      allow create, update: if canUseOperationalApp()
        && request.resource.data.userId is string
        && request.resource.data.moduleId is string
        && progressId == request.resource.data.userId + "_" + request.resource.data.moduleId;
      allow delete: if canUseOperationalApp();
    }

    match /calculatorStates/{docId} {
      allow read, write: if canUseOperationalApp();
    }

    match /userNotes/{docId} {
      allow read: if canUseOperationalApp();
      allow create: if canUseOperationalApp()
        && request.resource.data.userId is string
        && request.resource.data.content is string
        && request.resource.data.createdAt != null;
      allow update: if canUseOperationalApp()
        && keepsFieldsImmutable(["userId", "createdAt"]);
      allow delete: if canUseOperationalApp();
    }

    match /presence/{repId} {
      allow read: if canUseOperationalApp();
      allow create, update: if canUseOperationalApp()
        && request.resource.data.repId != null
        && request.resource.data.lastActive != null;
      allow delete: if canUseOperationalApp();
    }

    match /teamChat/{messageId} {
      allow read, create, update: if canUseOperationalApp();
      allow delete: if false;
    }

    match /dmChannels/{channelId}/messages/{messageId} {
      allow read, create, update: if canUseOperationalApp();
      allow delete: if false;
    }

    match /teamPosts/{postId} {
      allow read, create, update: if canUseOperationalApp();
      allow delete: if canUseOperationalApp();
    }

    match /userDevices/{docId} {
      allow read: if canUseOperationalApp();
      allow create: if canUseOperationalApp()
        && validUserDeviceCreate();
      allow update: if canUseOperationalApp()
        && validUserDeviceUpdate();
      allow delete: if canUseOperationalApp();
    }

    match /errors/{docId} {
      allow read: if canUseOperationalApp();
      allow create: if canUseOperationalApp();
      allow update, delete: if false;
    }

    match /auditLogs/{docId} {
      // Phase 3: written only by appendAuditEvent and settings admin callables.
      allow read: if hasElevatedRole();
      allow create: if false;
      allow update, delete: if false;
    }

    match /audit/{docId} {
      // Phase 3: legacy audit collection is read-only to elevated users.
      allow read: if hasElevatedRole();
      allow create: if false;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────
    // System / Read-only
    // ─────────────────────────────────────────────

    match /dailyStats/{docId} {
      allow read: if canUseOperationalApp();
      allow write: if false;
    }

    match /sentAlerts/{docId} {
      allow read: if canUseOperationalApp();
      allow write: if false;
    }

    match /properties/{docId} {
      allow read: if canUseOperationalApp();
      allow write: if false;
    }

    // ─────────────────────────────────────────────
    // Salestrail call records (callable-only access)
    // ─────────────────────────────────────────────

    match /salestrailCalls/{callId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────
    // Catch-all (deny everything else)
    // ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
