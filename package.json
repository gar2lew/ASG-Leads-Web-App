{
  "name": "asg-leads-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/write-release-metadata.cjs",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "test": "npm run test:auth-boundaries && npm run test:workflow-state && npm run test:region-identity && npm run test:observability && npm run test:release-metadata && npm run test:quick-pull-import",
    "test:auth-boundaries": "node scripts/test-auth-boundaries.cjs",
    "test:workflow-state": "node scripts/test-workflow-state.cjs",
    "test:region-identity": "node scripts/test-region-identity.cjs",
    "test:observability": "node scripts/test-observability.cjs",
    "test:release-metadata": "node scripts/test-release-metadata.cjs",
    "test:quick-pull-import": "node --experimental-strip-types scripts/test-quick-pull-import.mjs",
    "test:emulator:preflight": "node scripts/test-emulator-preflight.cjs",
    "test:emulator:firestore-smoke": "firebase emulators:exec --project demo-asg-crm-emulator --only firestore \"node scripts/test-emulator-firestore-smoke.cjs\"",
    "test:emulator:rules": "firebase emulators:exec --project demo-asg-crm-emulator --only firestore \"node scripts/test-firestore-rules-harness.cjs\"",
    "test:emulator:callables-dry-run": "firebase emulators:exec --project demo-asg-crm-emulator --only auth,firestore,functions \"node scripts/test-callable-emulator-dry-run-harness.cjs\"",
    "release:metadata": "node scripts/write-release-metadata.cjs",
    "release:deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1",
    "release:dry-run": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -DryRun",
    "preview": "vite preview",
    "lint": "eslint src functions/src --ext ts,tsx --report-unused-disable-directives --quiet",
    "lint:report": "eslint src functions/src --ext ts,tsx --report-unused-disable-directives",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2",
    "@react-google-maps/api": "^2.20.8",
    "firebase": "^10.8.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "protobufjs": "7.6.4"
  }
}
